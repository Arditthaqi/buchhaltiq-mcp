# Mode: "demo" (fixtures, no API key required) or "production" (real BuchhaltIQ API).
# Defaults to "demo" if unset.
BUCHHALTIQ_MCP_MODE=demo

# Production-mode credentials. Only required when BUCHHALTIQ_MCP_MODE=production.
# Never commit a real key — copy this file to .env and fill in your values.
BUCHHALTIQ_API_KEY=
BUCHHALTIQ_API_BASE_URL=https://api.buchhaltiq.de/v1
